# Aether AI OS — Required Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to the repository

# LLM Provider Keys (required for cloud tiers)
AETHER_LLM__ANTHROPIC_API_KEY=your-anthropic-key-here
AETHER_LLM__GOOGLE_API_KEY=your-google-key-here

# Voice — Wake Word (free tier from console.picovoice.ai)
AETHER_VOICE__PORCUPINE_ACCESS_KEY=your-porcupine-key-here

# Environment override (development or production)
AETHER_ENVIRONMENT=development
